generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Record {
  id        String   @id @default(uuid())
  title     String
  content   String?
  metadata  Json?
  imageUrl  String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}
