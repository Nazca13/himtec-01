generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model DailyRecord {
  id           String   @id @default(uuid())
  tipeInput    String // "TOMBOL_AMAN" | "TOMBOL_DARURAT" | "VOICE_NOTE"
  statusBahaya String   @default("HIJAU") // "HIJAU" | "KUNING" | "MERAH"
  aiAnalysis   Json? // hasil triage Gemini: gejala, ringkasan
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}
